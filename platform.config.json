{
  "platform": {
    "name": "AegisCore",
    "display_name": "AegisCore \u2014 Modular Cybersecurity Defense & Operations Platform",
    "version": "1.0.0",
    "description": "A modular, unified cybersecurity defensive research, telemetry, and operations platform",
    "author": "AegisCore SecOps",
    "license": "MIT"
  },
  "server": {
    "api_host": "0.0.0.0",
    "api_port": 8000,
    "dashboard_port": 3000,
    "debug": false
  },
  "database": {
    "engine": "sqlite",
    "sqlite_path": "aegiscore.db",
    "host": "${DB_HOST}",
    "port": 5432,
    "name": "${DB_NAME}",
    "user": "${DB_USER}",
    "password": "${DB_PASSWORD}"
  },
  "redis": {
    "host": "${REDIS_HOST}",
    "port": 6379,
    "fallback_in_memory": true
  },
  "logging": {
    "level": "INFO",
    "output": [
      "console",
      "file"
    ],
    "log_path": "./logs"
  },
  "features": {
    "enable_auth": true,
    "enable_rbac": true,
    "enable_audit_log": true,
    "enable_alerts": true,
    "enable_reports": true,
    "enable_ml_detection": true
  },
  "categories": [
    "Network Security",
    "Malware & Analysis",
    "Cryptography & Auth",
    "Web & App Security",
    "Threat Intelligence",
    "Forensics & Reverse Engineering",
    "System & Kernel Security",
    "Privacy & Anonymity",
    "Advanced Research",
    "IoT & ICS Security",
    "AI/ML Security",
    "Infrastructure"
  ],
