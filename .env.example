# AegisCore Platform Environment Configuration

# Application Environment
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=generate_a_secure_random_key_for_production_use_min_32_chars

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=3000

# First Run Admin Seeding (Secure: set here or pass interactively during setup)
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@aegiscore.local
ADMIN_SEED_PASSWORD=

# Database Configuration (Defaults to local SQLite fallback if DB_HOST is empty)
DB_ENGINE=sqlite
DB_SQLITE_PATH=aegiscore.db
DB_HOST=
DB_PORT=5432
DB_NAME=aegiscore
DB_USER=aegis_user
DB_PASSWORD=

# Redis Configuration (Defaults to in-memory event bus if REDIS_HOST is empty)
REDIS_HOST=
REDIS_PORT=6379

# Logging
LOG_LEVEL=INFO
LOG_OUTPUT=console,file
LOG_PATH=./logs
